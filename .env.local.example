# Supabase — get from supabase.com > project > settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # never expose this publicly

# Stripe — get from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create products in Stripe dashboard, paste price IDs here
STRIPE_MODULE_PRICE_ID=price_...           # one-time hardware pre-order ($299)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# Resend — get from resend.com
RESEND_API_KEY=re_...

# Site URL (for redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Analytics — get from vercel.com/account/tokens + project settings
VERCEL_ACCESS_TOKEN=your-personal-access-token
VERCEL_PROJECT_ID=your-project-id
VERCEL_TEAM_ID=your-team-id   # optional, only if on a team
